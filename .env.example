# Copy this file to .env and fill in your real values.
# Get these from: Supabase Dashboard → Project Settings → API Keys
# NEVER commit the real .env file or paste these values in chat/screenshots.

# App configuration
ADMIN_PASSWORD=changeme123
ADMIN_RESET_CODE=your-reset-code-here
PORT=3000
ALLOWED_ORIGINS=http://localhost:3000,https://your-deployed-domain.com

# Supabase backend
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=sb_anon_xxxxx
SUPABASE_SERVICE_KEY=sb_service_role_xxxxx

# Email / contact form (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password
MLA_EMAIL=mlaoffice@example.com
